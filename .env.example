# ==============================================================================
# eRTMAC-NWIS — Environment Configuration Template
# Oil India Limited (OIL) — Nearby Wells Intelligence System
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=3000
FASTAPI_PORT=8000

# Google Gemini AI API Key (Optional for RAG Knowledge Search, fallback is deterministic)
GEMINI_API_KEY=

# PostgreSQL + PostGIS Spatial Database Configuration
DATABASE_URL=postgresql://oil_user:oil_secure_pass@localhost:5432/ertmac_nwis
POSTGRES_USER=oil_user
POSTGRES_PASSWORD=oil_secure_pass
POSTGRES_DB=ertmac_nwis

# Redis In-Memory Telemetry Broker & Cache
REDIS_URL=redis://localhost:6379/0

# JWT & Authentication Secret
JWT_SECRET=oil-india-ertmac-nwis-jwt-secret-key-2026

# Active Well & Telemetry Simulation Parameters
ACTIVE_WELL_ID=OIL-ACTIVE-01
ACTIVE_WELL_NAME=NHK-Deep-504
TELEMETRY_INTERVAL_MS=1000
SPATIAL_DEFAULT_RADIUS_KM=25.0
